# ────────────────────────────────────────────────────────
# Playwright + AI — environment configuration
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────

# REQUIRED — Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...your-key-here

# OPTIONAL — defaults shown below

# Model to use. Check docs.claude.com for current recommended model.
# This book was tested against claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Circuit breaker: max USD spend per test run before throwing.
# Recommended: 0.50 local, 2.00 CI.
AI_COST_CAP=1.00

# Base URL for the app under test (used by some examples)
BASE_URL=http://localhost:5173

# Test credentials for fixtures.ts — STAGING ONLY, never prod
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=hunter2
